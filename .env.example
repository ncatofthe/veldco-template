# Environment variables for Veld Co

# Database (PostgreSQL)
DB_URL=postgresql://username:password@localhost:5432/veldco

# Server
PORT=3000
NODE_ENV=development

# Copy to .env and edit:
# cp .env.example .env
# brew install postgresql
# createdb veldco
# npm i
# npm run migrate  # after migrations/ created
# npm run dev

